
rule "Cold room 1 temperature warning"
when
    Item ColdRoom1_Temperature changed
then
    if (ColdRoom1_Temperature.state instanceof Number) {
        val temp = (ColdRoom1_Temperature.state as Number).doubleValue
        if (temp > 8) {
            logWarn("coldstorage", "CRITICAL: Cold room 1 temperature above 8 C: {}", ColdRoom1_Temperature.state)
        } else if (temp > 5) {
            logInfo("coldstorage", "WARNING: Cold room 1 temperature above 5 C: {}", ColdRoom1_Temperature.state)
        }
    }
end

